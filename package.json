{
  "name": "opencockpit",
  "version": "1.1.0",
  "description": "Dashboard de escritorio multi-herramienta: uso, costos, conversaciones y memorias de Claude Code, OpenCode, Codex, Gemini/Antigravity, Copilot, Cursor y Cline/Roo.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite\" \"wait-on tcp:5173 && cross-env COCKPIT_DEV=1 node scripts/launch.cjs\"",
    "build": "eslint . --max-warnings 99 && vite build",
    "start": "vite build && node scripts/launch.cjs",
    "dist": "node scripts/make-icon.cjs && vite build && electron-builder",
    "app": "node scripts/launch.cjs",
    "audit": "node scripts/audit.cjs",
    "watch-usage": "node scripts/watch-usage.cjs",
    "lint": "eslint .",
    "icon": "node scripts/make-icon.cjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.1",
    "chokidar": "^5.0.0",
    "d3-force": "^3.0.1",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.lucabaello1998.opencockpit",
    "productName": "OpenCockpit",
    "files": [
      "electron/**/*",
      "src/main/**/*",
      "dist/**/*",
      "build/icon.png",
      "package.json",
      "scripts/**/*",
      "!dist/win-unpacked",
      "!dist/*.exe",
      "!dist/*.blockmap"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "OpenCockpit-Setup-${version}.${ext}"
    },
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "lucabaello1998",
        "repo": "OpenCockpit"
      }
    ]
  },
  "author": "Luca Baello",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucabaello1998/OpenCockpit"
  },
  "license": "MIT",
  "keywords": [
    "claude-code",
    "opencode",
    "codex",
    "gemini",
    "electron",
    "dashboard"
  ],
  "private": true
}
